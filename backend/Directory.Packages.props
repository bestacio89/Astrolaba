<Project>
  <!--
    Versions des paquets NuGet, centralisées ici (un seul endroit à mettre à jour).
    Versions à confirmer avec l'équipe (voir docs/a-valider.md).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Les versions ci-dessous s'imposent aussi aux paquets utilisés indirectement (corrections de sécurité). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Base de données -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <!-- SQLitePCLRaw 2.1.11 bundles a vulnerable SQLite; use the patched 3.x bundle in test-only SQLite projects. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <!-- Keep Roslyn packages aligned: EF Design brings CSharp 5.6.0 but Workspaces 5.0.0. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <!-- API -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Identity.Web" Version="3.8.2" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.0.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <!-- Franz.Common -->
    <PackageVersion Include="Franz.Common.Business" Version="2.3.0" />
    <PackageVersion Include="Franz.Common.Mediator" Version="2.3.0" />
    <PackageVersion Include="Franz.Common.Logging" Version="2.3.0" />
    <PackageVersion Include="Franz.Common.Mediator.Polly" Version="2.3.0" />
    <PackageVersion Include="Franz.Common.Logging" Version="2.3.0" />
    <PackageVersion Include="Franz.Common.Mediator.Polly" Version="2.3.0" />
    <PackageVersion Include="Franz.Common.EntityFramework" Version="2.3.0" />
    <PackageVersion Include="Franz.Common.EntityFramework.PostGres" Version="2.3.0" />
    <!-- Corrections de sécurité de paquets utilisés indirectement (avis GitHub, octobre 2026) -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
