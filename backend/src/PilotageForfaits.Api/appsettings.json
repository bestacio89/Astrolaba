{
  "Service": {
    "Name": "Astrolaba.Api",
    "Version": "1.0.0"
  },
  "Logging": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Npgsql": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/astrolaba-api-.log",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Postgres",
    "ServerName": "127.0.0.1",
    "DatabaseName": "Astrolaba",
    "UserName": "postgres",
    "Port": 5432,
    "Ssl": "Disable"
  },
  "Authentification": {
    "Mode": "EntraId"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "A_RENSEIGNER",
    "ClientId": "A_RENSEIGNER",
    "Audience": "api://A_RENSEIGNER"
  },
  "Resilience": {
    "RetryPolicy": {
      "Enabled": true,
      "RetryCount": 3,
      "RetryIntervalMilliseconds": 500
    },
    "CircuitBreaker": {
      "Enabled": true,
      "FailureThreshold": 0.5,
      "MinimumThroughput": 10,
      "DurationOfBreakSeconds": 30
    },
    "TimeoutPolicy": {
      "Enabled": true,
      "TimeoutSeconds": 5
    }
  },
  "Cors": {
    "Policies": {
      "AllowAll": {
        "Origins": [
          "http://localhost:4200"
        ],
        "Methods": [
          "GET",
          "POST",
          "PUT",
          "PATCH",
          "DELETE",
          "OPTIONS"
        ],
        "Headers": [
          "*"
        ]
      }
    }
  }
}
